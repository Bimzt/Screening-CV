# Password bersama untuk akses tim rekrutmen
APP_PASSWORD=ganti_dengan_password_tim_rekrutmen

# Kunci rahasia HMAC untuk menandatangani session cookie (minimal 32 karakter acak)
SESSION_SECRET=ganti_dengan_rahasia_hmac_acak_minimal_32_karakter_12345

# Kredensial Google Service Account dalam format Base64
# Cara encode: [Convert]::ToBase64String([IO.File]::ReadAllBytes('service_account.json')) (PowerShell)
# atau: base64 -w 0 service_account.json (Linux/Mac)
GOOGLE_SERVICE_ACCOUNT_JSON_B64=
